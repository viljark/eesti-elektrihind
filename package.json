{
  "name": "eesti-elektrihind",
  "version": "1.0.0",
  "scripts": {
    "start": "APP_VARIANT=development npx expo start",
    "start:tunnel": "APP_VARIANT=development npx expo start --tunnel",
    "start:web": "APP_VARIANT=development npx expo start --web",
    "prebuild": "npx expo prebuild --platform android --clean",
    "build:dev": "APP_VARIANT=development eas build --profile development --platform android",
    "build:dev:local": "eas build --profile development --platform android  --local",
    "build:android:preview": "yarn prebuild && eas build -p android --profile preview",
    "build:android:production": "yarn prebuild && eas build -p android --profile production",
    "build:submit:android:production": "yarn prebuild && eas build -p android --profile production --auto-submit-with-profile=production",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production",
    "submit": "eas submit --platform android --profile production",
    "android": "npx expo run:android",
    "ios": "expo run:ios",
    "postinstall": "patch-package",
    "lint": "eslint **/*.{ts,tsx}"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@nandorojo/iconic": "^0.0.2",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^23.4.0",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/crashlytics": "^23.4.0",
    "@react-native-firebase/perf": "^23.4.0",
    "@shopify/react-native-skia": "^2.3.0",
    "@types/lodash": "^4.14.184",
    "eslint-plugin-jsx-expressions": "^1.3.1",
    "expo": "^54",
    "expo-background-task": "~1.0.8",
    "expo-dev-client": "~6.0.13",
    "expo-device": "~8.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.12",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-task-manager": "~14.0.8",
    "expo-updates": "~29.0.12",
    "lodash": "^4.17.21",
    "moti": "^0.30.0",
    "patch-package": "^6.4.7",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.7.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-svg": "15.12.1",
    "react-native-toggle-element": "^2.1.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "valtio": "^2.1.8",
    "victory-native": "^41.20.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^5.37.0",
    "@typescript-eslint/parser": "^5.37.0",
    "eslint": "8.22.0",
    "eslint-plugin-react": "^7.31.8",
    "typescript": "~5.9.2"
  },
  "private": true,
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0"
  }
}
